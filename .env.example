# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.

# URL do Google Apps Script que grava os leads na planilha (termina em /exec).
# Veja integracoes/google-sheets-apps-script.gs
NEXT_PUBLIC_LEADS_ENDPOINT=

# Google Tag Manager (opcional)
NEXT_PUBLIC_GTM_ID=

# Conversão de lead no Google Ads (ex.: AW-1234567890 e o rótulo da conversão)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Pixel do OpenAI Ads (ChatGPT Ads) - dispara "lead_created" no envio do formulário
NEXT_PUBLIC_OPENAI_PIXEL_ID=
